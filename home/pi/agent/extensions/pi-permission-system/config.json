{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",

    "path_read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },

    "path_write": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      ".pi/extensions/*": "ask",
      ".pi/agents/*": "ask",
      "~/.ssh/*": "deny"
    },

    "bash": {
      "*": "allow",

      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git branch -D*": "ask",
      "git branch -d*": "ask",
      "git tag -d*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git remote add*": "ask",
      "git remote remove*": "ask",
      "git remote rm*": "ask",
      "git remote set-url*": "ask",
      "git commit -m * -m *": "ask",
      "git commit --message=* --message=*": "ask",

      "git commit*": "allow"
    },
    "mcp": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
